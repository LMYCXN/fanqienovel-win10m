<Page x:Class="FanqieReader.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Margin="16,16,16,4">
      <TextBlock Text="番茄小说" FontSize="26" />
    </StackPanel>
        <Grid Grid.Row="1" Margin="12,8,12,8">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <StackPanel Margin="4,0,4,8">
            <TextBlock x:Name="ReaderStatusText" Text="离线演示数据" TextWrapping="Wrap" />
            <ProgressBar x:Name="ReaderProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6" />
            <Button x:Name="CancelReaderButton" Content="取消加载" Click="CancelReader_Click" Visibility="Collapsed" />
          </StackPanel>
          <Grid Grid.Row="1">
            <Grid x:Name="BooksPanel">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <ComboBox x:Name="SourcePicker" SelectedIndex="0" SelectionChanged="SourcePicker_SelectionChanged" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                <ComboBoxItem Content="离线演示" /><ComboBoxItem Content="番茄在线阅读" />
              </ComboBox>
              <TextBox x:Name="SearchBox" Grid.Row="1" PlaceholderText="搜索演示书名或作者" KeyDown="SearchBox_KeyDown" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
                <Button Content="搜索" Click="Search_Click" />
                <Button x:Name="ResumeButton" Content="继续上次阅读" Click="Resume_Click" Margin="8,0,0,0" />
              </StackPanel>
              <ListView x:Name="BooksList" Grid.Row="3" IsItemClickEnabled="True" ItemClick="Book_Click" SelectionMode="None">
                <ListView.ItemTemplate>
                  <DataTemplate><StackPanel Padding="0,10"><TextBlock Text="{Binding Title}" FontSize="22" /><TextBlock Text="{Binding Author}" Opacity="0.65" /></StackPanel></DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
              <Button x:Name="LoadMoreButton" Grid.Row="4" Content="加载更多" Click="LoadMore_Click" Visibility="Collapsed" HorizontalAlignment="Stretch" />
            </Grid>
            <Grid x:Name="CatalogPanel" Visibility="Collapsed">
              <ListView x:Name="ChaptersList" IsItemClickEnabled="True" ItemClick="Chapter_Click" SelectionMode="None">
                <ListView.Header>
                  <StackPanel Margin="0,0,0,12">
                    <Button Content="返回书籍" Click="BackToBooks_Click" />
                    <TextBlock x:Name="BookTitleText" FontSize="24" TextWrapping="Wrap" Margin="0,12,0,4" />
                    <TextBlock x:Name="BookSummaryText" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="SummaryToggleButton" Content="展开简介" Click="ToggleSummary_Click" Margin="0,8,0,0" />
                  </StackPanel>
                </ListView.Header>
                <ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" Padding="0,12" TextWrapping="Wrap" /></DataTemplate></ListView.ItemTemplate>
              </ListView>
            </Grid>
            <Grid x:Name="ReadingPanel" Visibility="Collapsed">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel>
                <TextBlock x:Name="ChapterTitleText" FontSize="23" TextWrapping="Wrap" Margin="8,8,8,0" />
                <StackPanel Orientation="Horizontal" Margin="8,8">
                  <Button Content="A−" Click="SmallerFont_Click" />
                  <Button Content="A+" Click="LargerFont_Click" Margin="8,0" />
                  <ToggleSwitch x:Name="NightSwitch" Header="夜间" Toggled="NightSwitch_Toggled" />
                </StackPanel>
              </StackPanel>
              <ScrollViewer x:Name="ChapterScroller" Grid.Row="1">
                <StackPanel x:Name="ParagraphsPanel" Margin="12,8,12,24" />
              </ScrollViewer>
              <Grid Grid.Row="2" Margin="4,8">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button x:Name="PreviousButton" Content="上一章" Click="Previous_Click" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="目录" Click="BackToCatalog_Click" HorizontalAlignment="Stretch" Margin="8,0" />
                <Button x:Name="NextButton" Grid.Column="2" Content="下一章" Click="Next_Click" HorizontalAlignment="Stretch" />
              </Grid>
            </Grid>
          </Grid>
        </Grid>
  </Grid>
</Page>
